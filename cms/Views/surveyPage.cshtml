@using Umbraco.Cms.Web.Common
@inherits UmbracoViewPage

@{
    Layout = null;

    var formIdValue = Context.Request.Query["formId"].FirstOrDefault();

    Guid formId;
    var validFormId = Guid.TryParse(formIdValue, out formId);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Survey</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="/css/survey-form.css" />

    <script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-3.0.0.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/jquery.validate/1.19.2/jquery.validate.min.js"></script>
    <script src="https://ajax.aspnetcdn.com/ajax/mvc/5.2.3/jquery.validate.unobtrusive.min.js"></script>
</head>

<body class="bg-light">

    <div class="container py-5">

        @if (!validFormId)
        {
            <div class="alert alert-success text-center">
                Survey Submitted Successfully.
            </div>
            <a href="http://localhost:5173/survey" class="btn btn-secondary"> Go back</a>
        }
        else
        {
            <div class="card shadow-sm mx-auto survey-card">
                <div class="card-body">

                    @await Component.InvokeAsync(
                        "RenderForm",
                        new
                        {
                            formId = formId,
                            theme = "default",
                            includeScripts = true
                        }
                    )

                </div>
            </div>
        }

    </div>

</body>
</html>